# Required: shared bearer token for API authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CELEGANS_TOKEN=your-secret-token-here

# Root directory for all captured data (outside the repo)
CELEGANS_DATA_ROOT=/home/pi/celegans-data

# Network interface to bind to (0.0.0.0 = all interfaces, including ethernet link)
CELEGANS_HOST=0.0.0.0

# Port the API listens on
CELEGANS_PORT=8000

# AE shutter cap in microseconds: AE cannot choose a longer exposure than this.
# Default 500000 = 500 ms. In dim light the image will be darker but never frozen.
CELEGANS_MAX_AUTO_SHUTTER_US=500000

# Capture-time storage guard: a capture is refused with HTTP 507 if free disk is
# still below this (GB) after attempting reclamation. Prevents a full card from
# producing partial/failed frames; the user must sync to the laptop and retry.
CELEGANS_CAPTURE_MIN_FREE_GB=2.0

# Retention daemon settings (used by capture/retention.py)
# Minimum free disk to consider OK (GB) — if above this and no age violations, daemon exits early
# The four RETENTION_* keys below are read from the environment by
# retention.py, which runs as its own systemd unit. They are NOT fields on the
# capture service's Settings model. That is fine — the service ignores unknown
# CELEGANS_* keys — but it means setting them here only affects retention if
# this file is also the retention unit's EnvironmentFile.
CELEGANS_RETENTION_MIN_FREE_GB=5
# Target free disk to reach when evicting (GB)
CELEGANS_RETENTION_TARGET_FREE_GB=10
# Maximum age of any acked file before it is deleted regardless of disk (days)
CELEGANS_RETENTION_MAX_AGE_DAYS=30
# Recycle bin: permanently purge .trash contents older than this (days)
CELEGANS_RETENTION_TRASH_MAX_AGE_DAYS=7
