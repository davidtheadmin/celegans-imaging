# Image data — too large for version control
data/raw/
data/processed/
data/flatfield/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Model weights — large binaries, distributed out-of-band (never in history)
*.pt
launcher/vision/models/

# Vision inference venv (separate venv for licence isolation and weight, not for
# a version split - both venvs are Python 3.13; the .venv/ rule doesn't match this name)
launcher/vision/.venv-vision/

# Secrets — capture/.env holds the shared bearer token. The Pi is a git working
# tree, so without this a `git add -A` there commits the token to history.
.env
capture/.env

# OS
.DS_Store
.claude/

# Generated diagnostic outputs (archived in docs/calibration/ when finalised)
launcher/worm_diagnostics/

# Installer build scaffolding and output (see packaging/README.md)
packaging/_build/
packaging/dist/
.wsstage/
